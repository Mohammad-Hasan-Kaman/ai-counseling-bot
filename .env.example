# Bale bot token
BOT_TOKEN=your_bale_bot_token
# Comma-separated Bale user IDs of administrators (find yours with /myid)
ADMIN_USER_IDS=123456789,987654321
# Password for the in-bot admin panel (used by /admin)
ADMIN_PANEL_PASSWORD=change_me
# The counseling center this deployment serves (name shown in bot messages)
CENTER_NAME=مرکز مشاوره خانواده
# Base URL of the center's website; team page is CENTER_BASE_URL + /team/
CENTER_BASE_URL=https://example.com
# Optional: full team-page URL if it differs from the default above
# CENTER_TEAM_URL=https://example.com/team/
# Optional: path of the counselors Excel file used by load_clean.py
# CONSULTANT_EXCEL_PATH=data/consultants.xlsx
